# =========================================================
# ZIRAK STREAM — ENVIRONMENT VARIABLES
# Copy this file to .env.local for development.
# In production (Vercel), set these under Project Settings > Environment Variables.
# Never commit .env.local or any file containing real secrets.
# =========================================================

# ---------------------------------------------------------
# SUPABASE
# Found in: Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER expose to the client or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-ref
# Direct Postgres connection string (for migrations / scripts)
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ---------------------------------------------------------
# CLOUDFLARE R2 (S3-compatible object storage for video/posters/subtitles)
# Found in: Cloudflare Dashboard > R2 > Manage API Tokens
# ---------------------------------------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=zirak-stream-media
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Public bucket URL (custom domain or r2.dev subdomain) used to build playable/public asset URLs
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.zirakstream.com

# ---------------------------------------------------------
# APP
# ---------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Zirak Stream"
# Random 32+ char secret used for signing internal tokens (e.g. resume tokens)
APP_SECRET=generate-a-long-random-string

# ---------------------------------------------------------
# AUTH — GOOGLE OAUTH (configured in Supabase Auth providers, listed here for reference)
# ---------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
